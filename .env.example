# cassandra-go-perf-tool — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# HTTP port for the main UI + REST API + SSE server (default: 3000)
PORT=3000

# Internal HTTP port for Prometheus metrics scraping (default: 9090)
METRICS_PORT=9090

# Directory for built-in YAML workloads (default: /app/workloads)
WORKLOADS_DIR=/app/workloads

# Directory for user-uploaded custom YAML workloads (default: /app/workloads/custom)
CUSTOM_WORKLOADS_DIR=/app/workloads/custom

# Directory for uploaded Astra Secure Connect Bundles (default: /app/scb)
SCB_DIR=/app/scb

# Directory for run history logs and reports (default: /app/logs)
LOGS_DIR=/app/logs
